msgstr "Nom"

#: src/pages/transition/PublicsPanel.tsx
msgid "Meaning"
msgstr "Significat"

#: src/pages/transition/PublicsPanel.tsx
msgid "Read by"
msgstr "Llegit per"

#: src/pages/transition/PublicsPanel.tsx
msgid "All 64 registers"
msgstr "Els 64 registres"

#: src/pages/transition/PublicsPanel.tsx
msgid "Each register as the proven program wrote it, in decimal. Registers 46 to 63 are padding and always zero."
msgstr "Cada registre tal com el va escriure el programa de la prova, en decimal. Els registres 46 a 63 són farciment i sempre valen zero."

#: src/pages/transition/PublicsPanel.tsx
msgid "The public values as sent (publicValues, 512 bytes)"
msgstr "Els valors públics tal com es van enviar (publicValues, 512 bytes)"

