msgid "the manager’s 4-byte prefix and the epoch nonce"
msgstr "el prefix de 4 bytes del gestor i el nonce de l'època"

#: src/pages/contracts/DkgPanel.tsx
msgid "the epoch’s number on the DKG"
msgstr "el número de l'època al DKG"

