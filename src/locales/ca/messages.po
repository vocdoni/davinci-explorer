msgid "{newVoters, plural, one {# new voter} other {# new voters}} · {overwrites, plural, one {# changed vote} other {# changed votes}}"
msgstr "{newVoters, plural, one {# votant nou} other {# votants nous}} · {overwrites, plural, one {# vot canviat} other {# vots canviats}}"

#: src/pages/transition/Summary.tsx
msgid "The election’s counts after this batch, as the registry recorded them."
msgstr "Les xifres de la votació després d'aquest lot, tal com les va anotar el registre."

#: src/pages/transition/Summary.tsx
msgid "Totals after"
msgstr "Totals posteriors"

