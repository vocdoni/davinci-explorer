msgstr "Lot núm. {index}: {votes, plural, one {# vot} other {# vots}} en {nBlobs, plural, one {# blob de dades} other {# blobs de dades}}"

#: src/indexer/selectors.ts
msgid "Batch #{index} in {nBlobs, plural, one {# data blob} other {# data blobs}}"
msgstr "Lot núm. {index} en {nBlobs, plural, one {# blob de dades} other {# blobs de dades}}"

#: src/indexer/selectors.ts
msgid "Results published"
msgstr "Resultats publicats"

#: src/indexer/selectors.ts
msgid "Status changed from {from} to {to}"
msgstr "Canvi d'estat: abans {from}, ara {to}"

#: src/indexer/selectors.ts
msgid "Results requested with nothing to decrypt: no ballot was counted"
msgstr "Resultats sol·licitats sense res a desxifrar: no es va comptar cap papereta"

#: src/indexer/selectors.ts
msgid "Encrypted total sent to the key committee to decrypt ({count, plural, one {# field} other {# fields}})"
msgstr "Total xifrat enviat al comitè de claus per desxifrar-lo ({count, plural, one {# camp} other {# camps}})"

#: src/indexer/selectors.ts
msgid "List of voters replaced"
msgstr "Llista de votants substituïda"

#: src/indexer/selectors.ts
msgid "New description published"
msgstr "Nova descripció publicada"

#: src/indexer/selectors.ts
msgid "End time changed"
msgstr "Hora de finalització canviada"

#: src/indexer/selectors.ts
msgid "Voter limit set to {maxVoters}"
msgstr "Límit de votants fixat en {maxVoters}"

