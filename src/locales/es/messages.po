msgstr "La suma de cada valor elevado a {exponent} es como máximo el peso del votante en la lista de votantes (maxValueSum es 0)."

#: src/pages/process/ballot-mode.ts
msgid "The sum of each value raised to the power {exponent} is at most {most} and at least {least}."
msgstr "La suma de cada valor elevado a {exponent} es como máximo {most} y como mínimo {least}."

#: src/pages/process/ballot-mode.ts
msgid "The sum of each value raised to the power {exponent} is at most {most}."
msgstr "La suma de cada valor elevado a {exponent} es como máximo {most}."

#: src/pages/process/ballot-mode.ts
msgid "No ballot can meet these rules: the group size, {size}, is larger than the number of fields, {count}."
msgstr "Ninguna papeleta puede cumplir estas reglas: el tamaño del grupo, {size}, es mayor que el número de campos, {count}."

#: src/pages/process/ballot-mode.ts
msgid "No ballot can meet these rules: the lowest value allowed, {min}, is above the highest, {max}."
msgstr "Ninguna papeleta puede cumplir estas reglas: el valor mínimo permitido, {min}, es mayor que el máximo, {max}."

#: src/pages/process/ballot-mode.ts
msgid "No ballot can meet these rules: the {fields, plural, one {# field} other {# fields}} must all differ, but only {allowed, plural, one {# value is} other {# values are}} allowed."
msgstr "Ninguna papeleta puede cumplir estas reglas: {fields, plural, one {el # campo debe ser distinto} other {los # campos deben ser todos distintos}}, pero solo {allowed, plural, one {se permite # valor} other {se permiten # valores}}."

#: src/pages/process/ballot-mode.ts
msgid "No ballot can meet these rules: the sum must be at least {least} and at most {most}."
msgstr "Ninguna papeleta puede cumplir estas reglas: la suma tiene que ser como mínimo {least} y como máximo {most}."

#: src/pages/process/ballot-mode.ts
msgid "No ballot can meet these rules: the smallest sum the fields can reach is {lowest}, above the maximum of {most}."
msgstr "Ninguna papeleta puede cumplir estas reglas: la suma más pequeña que pueden alcanzar los campos es {lowest}, por encima del máximo de {most}."

#: src/pages/process/ballot-mode.ts
msgid "No ballot can meet these rules: the largest sum the fields can reach is {highest}, below the minimum of {least}."
msgstr "Ninguna papeleta puede cumplir estas reglas: la suma más grande que pueden alcanzar los campos es {highest}, por debajo del mínimo de {least}."

#: src/pages/process/ballot-mode.ts
msgid "The ballot has {fields, plural, one {# field} other {# fields}}, usually one per option; each holds a number between {min} and {max}."
msgstr "La papeleta tiene {fields, plural, one {# campo} other {# campos}}, normalmente uno por opción; cada uno contiene un número entre {min} y {max}."

#: src/pages/process/ballot-mode.ts
#: src/pages/process/tabs/OverviewTab.tsx
msgid "No two fields may carry the same value."
msgstr "Dos campos no pueden llevar el mismo valor."

#: src/pages/process/ballot-mode.ts
msgid "Fields come in groups of {size}, one group per question. The ballot proof only checks that a group is not larger than the whole ballot."
msgstr "Los campos van en grupos de {size}, un grupo por pregunta. La prueba de la papeleta solo comprueba que un grupo no sea más grande que la papeleta entera."

#: src/pages/process/ballot-mode.ts
msgid "The results add up each field over every voter's latest vote: an option's result is the sum of the values voters gave it."
msgstr "Los resultados suman cada campo sobre el último voto de cada votante: el resultado de una opción es la suma de los valores que le dieron los votantes."

#: src/pages/process/ballot-mode.ts
msgid "Cannot be satisfied"
