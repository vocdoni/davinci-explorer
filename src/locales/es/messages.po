msgstr "{used} de {capacity}"

#: src/pages/process/tabs/OverviewTab.tsx
msgid "The highest total one option could reach if every voter gave it the maximum. The registry keeps it at or below one trillion, so the results can always be decrypted: <0/>."
msgstr "El total más alto que podría alcanzar una opción si todos los votantes le dieran el máximo. El registro lo mantiene en un billón o menos, así que los resultados siempre se pueden descifrar: <0/>."

#: src/pages/process/tabs/OverviewTab.tsx
msgid "Largest possible result per field"
msgstr "Resultado máximo posible por campo"

#: src/pages/process/tabs/OverviewTab.tsx
msgid "limit {cap}"
msgstr "límite {cap}"

