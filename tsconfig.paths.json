{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~app/*": [
        "src/app/*"
      ],
      "~components": [
        "src/components/index.ts"
      ],
      "~components/*": [
        "src/components/*"
      ],
      "~config/*": [
        "src/config/*"
      ],
      "~contracts/*": [
        "src/contracts/*"
      ],
      "~data/*": [
        "src/data/*"
      ],
      "~fixtures/*": [
        "src/fixtures/*"
      ],
      "~hooks/*": [
        "src/hooks/*"
      ],
      "~i18n/*": [
        "src/i18n/*"
      ],
      "~indexer/*": [
        "src/indexer/*"
      ],
      "~kit": [
        "src/kit/index.ts"
      ],
      "~kit/*": [
        "src/kit/*"
      ],
      "~lib/*": [
        "src/lib/*"
      ],
      "~pages/*": [
        "src/pages/*"
      ],
      "~protocol/*": [
        "src/protocol/*"
      ],
      "~routes/*": [
        "src/routes/*"
      ],
      "~theme/*": [
        "src/theme/*"
      ]
    }
  }
}
